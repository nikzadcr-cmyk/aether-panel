{
  "name": "aether-panel",
  "version": "0.1.0",
  "description": "Aether Panel — modern, modular Cloudflare Worker proxy panel (VLESS/Trojan/VMess over WebSocket) with D1 + Durable Objects.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "tailconfig": "wrangler tail",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply aether --local",
    "db:migrate:remote": "wrangler d1 migrations apply aether --remote",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "drizzle-orm": "^0.36.4",
    "hono": "^4.6.14"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.5.40",
    "@cloudflare/workers-types": "^4.20241218.0",
    "drizzle-kit": "^0.28.1",
    "typescript": "^5.7.2",
    "vitest": "2.1.8",
    "wrangler": "^3.95.0"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT"
}
